# Nusxa oling: cp .env.example .env
# Terminlar bazasi fayli (repo ildiziga nisbatan yoki absolyut yo'l).
UZTERM_TERMS_PATH=data/terms.json
# API qabul qiladigan eng uzun matn (Unicode belgilari).
UZTERM_MAX_TEXT_CHARS=20000
# Matnlar (raw/), annotatsiyalar (annotations/) va baholar (judgments/) papkasi.
UZTERM_DATA_DIR=data
# Web interfeys orqali annotatsiya va baholarni diskka yozish: on | off.
UZTERM_ANNOTATION=on
# Annotatorga taklif beradigan CRF modeli (python -m app.models.experiment yaratadi).
UZTERM_MODEL_PATH=models/crf.crfsuite
